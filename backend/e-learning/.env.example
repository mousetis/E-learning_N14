# Sao chép file này thành ".env" (đã được .gitignore bỏ qua) rồi điền giá trị thật.
# KHÔNG commit file .env.

# ----- Database PostgreSQL (ví dụ Neon: thêm ?sslmode=require) -----
DB_URL=jdbc:postgresql://localhost:5432/e_learning
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ----- JWT (tối thiểu 32 ký tự) -----
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# ----- Redis (OTP) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
# OTP_MODE=memory   # bỏ comment nếu chưa có Redis (chỉ dùng khi dev)

# ----- Email (Gmail SMTP). Để trống MAIL_USERNAME => OTP được ghi ra log thay vì gửi email -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=

# ----- Địa chỉ backend mà điện thoại truy cập được (IP LAN) -----
PUBLIC_BASE_URL=http://192.168.1.10:8080
# Deep link của app để quay về sau thanh toán, ví dụ: elearning://payment-result
PAYMENT_APP_REDIRECT_URL=

# ----- VNPay sandbox (để trống nếu chỉ dùng thanh toán MOCK) -----
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ----- PDF -----
# Đường dẫn font .ttf hỗ trợ tiếng Việt cho chứng chỉ / báo cáo PDF (để trống = tự dò font hệ thống)
PDF_FONT_PATH=
